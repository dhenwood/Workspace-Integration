CLIENT_ID=<provideClientId>
CLIENT_SECRET=<provideClientSecret>
ACCESS_TOKEN=
ACCESS_TOKEN_EXPIRES_AT=0
REFRESH_TOKEN=<provideRefreshToken>
REFRESH_TOKEN_EXPIRES_AT=0
APP_ID=<provideAppId>
# Must match the webhook username/password sent in the provisioning PATCH
WEBHOOK_USERNAME=<provideWebhookUsername>
WEBHOOK_PASSWORD=<provideWebhookPassword>
# Optional
# WEBHOOK_PATH=/onholdintegration
# LOG_FILE=output.txt
